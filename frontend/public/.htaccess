<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward all /api requests directly to your GoDaddy VPS Node.js backend
  RewriteRule ^api/(.*)$ http://97.74.95.56:5000/api/$1 [P,L]

  # 2. Never let the SPA catch /api
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 3. Standard SPA Catch-All Fallback for React/Vite routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
